<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Version>0.2.0-alpha</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <AssemblyTitle>Mnshor</AssemblyTitle>
    <Product>Mnshor</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Content Remove="Components\Pages\Promo.razor" />
    <None Remove="Components\Pages\Promo.razor" />
    <Content Remove="wwwroot\css\promo-motion.css" />
    <None Remove="wwwroot\css\promo-motion.css" />
    <Content Remove="wwwroot\demo\**" />
    <None Remove="wwwroot\demo\**" />
  </ItemGroup>

</Project>
