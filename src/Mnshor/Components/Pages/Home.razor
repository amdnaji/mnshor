@page "/"
@rendermode InteractiveServer
@inject LocalizationState Loc
@implements IDisposable

<PageTitle>@Loc["AppName"] - @Loc["AppTagline"]</PageTitle>

<section class="hero-section">
    <div class="hero-logo-badge">
        <MnshorLogo Size="72" Animated="true" />
    </div>
    <h1 class="hero-title">@Loc["AppName"]</h1>
    <p class="hero-subtitle">@Loc["AppTagline"]</p>
</section>

<div class="tools-grid">
    <!-- Tool 1: Merge PDF -->
    <a href="/merge" class="tool-card">
        <div class="tool-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="12" y1="18" x2="12" y2="12"></line>
                <line x1="9" y1="15" x2="15" y2="15"></line>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["MergePdfTitle"]</h2>
        <p class="tool-desc">@Loc["MergePdfDesc"]</p>
        <div class="tool-cta">
            <span>@(Loc.IsRtl ? "ابدأ دمج الملفات" : "Start Merging")</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>

    <!-- Tool 2: Split PDF -->
    <a href="/split" class="tool-card">
        <div class="tool-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="6" cy="18" r="3"></circle>
                <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
                <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
                <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["SplitPdfTitle"]</h2>
        <p class="tool-desc">@Loc["SplitPdfDesc"]</p>
        <div class="tool-cta">
            <span>@(Loc.IsRtl ? "ابدأ تقسيم المستند" : "Start Splitting")</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>

    <!-- Tool 3: Rotate PDF -->
    <a href="/rotate" class="tool-card">
        <div class="tool-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
                <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
                <path d="M21 21v-5h-5"></path>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["RotatePdfTitle"]</h2>
        <p class="tool-desc">@Loc["RotatePdfDesc"]</p>
        <div class="tool-cta">
            <span>@Loc["StartRotating"]</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>

    <!-- Tool 4: Remove PDF Pages -->
    <a href="/remove-pages" class="tool-card">
        <div class="tool-icon-wrapper" style="color: var(--danger); background: var(--danger-surface);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                <line x1="10" y1="11" x2="10" y2="17"></line>
                <line x1="14" y1="11" x2="14" y2="17"></line>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["RemovePagesTitle"]</h2>
        <p class="tool-desc">@Loc["RemovePagesDesc"]</p>
        <div class="tool-cta" style="color: var(--danger);">
            <span>@Loc["StartRemoving"]</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>

    <!-- Tool 5: Reorder & Reverse PDF -->
    <a href="/reorder" class="tool-card">
        <div class="tool-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 3 21 3 21 8"></polyline>
                <line x1="4" y1="20" x2="21" y2="3"></line>
                <polyline points="21 16 21 21 16 21"></polyline>
                <line x1="15" y1="15" x2="21" y2="21"></line>
                <line x1="4" y1="4" x2="9" y2="9"></line>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["ReorderPdfTitle"]</h2>
        <p class="tool-desc">@Loc["ReorderPdfDesc"]</p>
        <div class="tool-cta">
            <span>@Loc["StartReordering"]</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>

    <!-- Tool 6: PDF Metadata & Privacy Sanitizer -->
    <a href="/metadata" class="tool-card">
        <div class="tool-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["MetadataPdfTitle"]</h2>
        <p class="tool-desc">@Loc["MetadataPdfDesc"]</p>
        <div class="tool-cta">
            <span>@Loc["StartMetadata"]</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>

    <!-- Tool 7: Watermark PDF (iLovePDF Style) -->
    <a href="/watermark" class="tool-card">
        <div class="tool-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["WatermarkPdfTitle"]</h2>
        <p class="tool-desc">@Loc["WatermarkPdfDesc"]</p>
        <div class="tool-cta">
            <span>@Loc["StartWatermarking"]</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>

    <!-- Tool 8: Word to PDF -->
    <a href="/word-to-pdf" class="tool-card">
        <div class="tool-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["WordToPdfTitle"]</h2>
        <p class="tool-desc">@Loc["WordToPdfDesc"]</p>
        <div class="tool-cta">
            <span>@(Loc.IsRtl ? "ابدأ تحويل Word" : "Start Converting")</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>

    <!-- Tool 9: Excel (.xlsx) & Markdown to PDF -->
    <a href="/excel-markdown-to-pdf" class="tool-card">
        <div class="tool-icon-wrapper" style="color: var(--success); background: var(--success-surface);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="3" y1="15" x2="21" y2="15"></line>
                <line x1="9" y1="3" x2="9" y2="21"></line>
                <line x1="15" y1="3" x2="15" y2="21"></line>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["ExcelMarkdownTitle"]</h2>
        <p class="tool-desc">@Loc["ExcelMarkdownDesc"]</p>
        <div class="tool-cta" style="color: var(--success);">
            <span>@Loc["StartExcelMarkdown"]</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>

    <!-- Tool 10: Sign PDF (iLovePDF Style + OS Fonts) -->
    <a href="/sign" class="tool-card">
        <div class="tool-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["SignPdfTitle"]</h2>
        <p class="tool-desc">@Loc["SignPdfDesc"]</p>
        <div class="tool-cta">
            <span>@Loc["StartSigning"]</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>

    <!-- Tool 11: PowerPoint (.pptx) <-> PDF -->
    <a href="/powerpoint-pdf" class="tool-card">
        <div class="tool-icon-wrapper" style="color: #D97706; background: #FEF3C7;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["PowerPointPdfTitle"]</h2>
        <p class="tool-desc">@Loc["PowerPointPdfDesc"]</p>
        <div class="tool-cta" style="color: #D97706;">
            <span>@Loc["StartPowerPointPdf"]</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>

    <!-- Tool 12: PDF to Images (JPG / PNG / WebP & Extract Images) -->
    <a href="/pdf-to-images" class="tool-card">
        <div class="tool-icon-wrapper" style="color: #0891B2; background: #ECFEFF;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["PdfToImagesTitle"]</h2>
        <p class="tool-desc">@Loc["PdfToImagesDesc"]</p>
        <div class="tool-cta" style="color: #0891B2;">
            <span>@Loc["StartPdfToImages"]</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>

    <!-- Tool 13: Images to PDF (JPG / PNG / WebP -> PDF) -->
    <a href="/images-to-pdf" class="tool-card">
        <div class="tool-icon-wrapper" style="color: #7C3AED; background: #F5F3FF;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <circle cx="10" cy="13" r="1.5"></circle>
                <polyline points="18 18 14 14 8 20"></polyline>
            </svg>
        </div>
        <h2 class="tool-title">@Loc["ImagesToPdfTitle"]</h2>
        <p class="tool-desc">@Loc["ImagesToPdfDesc"]</p>
        <div class="tool-cta" style="color: #7C3AED;">
            <span>@Loc["StartImagesToPdf"]</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </div>
    </a>
</div>

@code {
    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }
}
