@code {
    private enum PromoReel { MediaSlides, SignPdf, Suite }

    private static readonly double[] MediaSceneStarts = [0.0, 4.5, 9.0, 13.5, 18.0, 22.5, 27.5, 32.5];
    private static readonly double[] SuiteSceneStarts = [0.0, 4.0, 8.0, 13.0, 17.5];
    private static readonly double[] SignSceneStarts = [0.0, 4.0, 8.5, 13.5, 19.0, 22.5, 26.5];

    private PromoReel _reelMode = PromoReel.MediaSlides;
    private double _elapsedSeconds = 0.0;
    private int _currentScene = 1;
    private bool _isPlaying = true;
    private System.Timers.Timer? _timer;
    private int _lastRenderedSignScene = 0;

    private int SceneCount => _reelMode switch
    {
        PromoReel.MediaSlides => 8,
        PromoReel.SignPdf => 7,
        _ => 5
    };
    private double TotalDurationSeconds => _reelMode switch
    {
        PromoReel.MediaSlides => 37.0,
        PromoReel.SignPdf => 30.0,
        _ => 22.0
    };
    private double ProgressPercent => Math.Clamp((_elapsedSeconds / TotalDurationSeconds) * 100.0, 0.0, 100.0);

    private bool IsSceneExiting
    {
        get
        {
            if (!_isPlaying || _reelMode != PromoReel.MediaSlides) return false;
            double sceneEnd = _currentScene < MediaSceneStarts.Length
                ? MediaSceneStarts[_currentScene]
                : TotalDurationSeconds;
            return (sceneEnd - _elapsedSeconds) <= 0.45 && (sceneEnd - _elapsedSeconds) > 0.0;
        }
    }

    protected override void OnInitialized()
    {
        Loc.OnChange += OnLocChanged;
        _timer = new System.Timers.Timer(100);
        _timer.Elapsed += OnTick;
        _timer.AutoReset = true;
        _timer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_reelMode == PromoReel.SignPdf && (_currentScene == 2 || _currentScene == 4))
        {
            if (_lastRenderedSignScene != _currentScene)
            {
                _lastRenderedSignScene = _currentScene;
                var canvasId = _currentScene == 2 ? "promo-sign-canvas-s2" : "promo-sign-canvas-s4";
                try
                {
                    await JS.InvokeVoidAsync("mnshor.renderPromoPdfPage", "/demo/myFile.pdf", canvasId);
                }
                catch (JSDisconnectedException) { }
            }
        }
        else
        {
            _lastRenderedSignScene = 0;
        }
    }

    private void OnLocChanged() => InvokeAsync(StateHasChanged);

    private void OnTick(object? sender, System.Timers.ElapsedEventArgs e)
    {
        if (!_isPlaying) return;

        _elapsedSeconds += 0.1;
        if (_elapsedSeconds >= TotalDurationSeconds)
        {
            _elapsedSeconds = 0.0;
        }

        _currentScene = ComputeScene(_elapsedSeconds);
        _ = InvokeAsync(StateHasChanged);
    }

    private int ComputeScene(double t)
    {
        if (_reelMode == PromoReel.MediaSlides)
        {
            if (t < 4.5) return 1;
            if (t < 9.0) return 2;
            if (t < 13.5) return 3;
            if (t < 18.0) return 4;
            if (t < 22.5) return 5;
            if (t < 27.5) return 6;
            if (t < 32.5) return 7;
            return 8;
        }

        if (_reelMode == PromoReel.Suite)
        {
            if (t < 4.0) return 1;
            if (t < 8.0) return 2;
            if (t < 13.0) return 3;
            if (t < 17.5) return 4;
            return 5;
        }

        if (t < 4.0) return 1;
        if (t < 8.5) return 2;
        if (t < 13.5) return 3;
        if (t < 19.0) return 4;
        if (t < 22.5) return 5;
        if (t < 26.5) return 6;
        return 7;
    }

    private void SwitchReel(PromoReel mode)
    {
        if (_reelMode == mode) return;
        _reelMode = mode;
        _elapsedSeconds = 0.0;
        _currentScene = 1;
        _lastRenderedSignScene = 0;
        _isPlaying = true;
    }

    private void TogglePlay() => _isPlaying = !_isPlaying;

    private void Restart()
    {
        _elapsedSeconds = 0.0;
        _currentScene = 1;
        _lastRenderedSignScene = 0;
        _isPlaying = true;
    }

    private void JumpToScene(int scene)
    {
        if (scene < 1 || scene > SceneCount) return;
        var starts = _reelMode switch
        {
            PromoReel.MediaSlides => MediaSceneStarts,
            PromoReel.Suite => SuiteSceneStarts,
            _ => SignSceneStarts
        };
        _elapsedSeconds = starts[scene - 1];
        _currentScene = scene;
    }

    private async Task ToggleFullscreen()
    {
        try
        {
            await JS.InvokeVoidAsync("mnshor.toggleFullscreen", "promo-stage");
        }
        catch (JSDisconnectedException) { }
    }

    public void Dispose()
    {
        Loc.OnChange -= OnLocChanged;
        if (_timer is not null)
        {
            _timer.Stop();
            _timer.Dispose();
        }
    }
}
