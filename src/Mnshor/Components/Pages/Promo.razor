                @(Loc.IsRtl ? "إعادة" : "Restart")
            </button>
        </div>

        <div class="promo-scene-pills" aria-label="Scenes">
            @for (int i = 1; i <= SceneCount; i++)
            {
                var sceneIndex = i;
                <button type="button"
                        class="promo-scene-pill @(_currentScene == sceneIndex ? "active" : "")"
                        @onclick="() => JumpToScene(sceneIndex)">
                    @sceneIndex
                </button>
            }
